# ============================================
# SAFEGUARD PROJECT - GITIGNORE
# SECURITY-FIRST: No secrets, no exceptions
# ============================================

# ── SECRETS & CREDENTIALS (NEVER COMMIT) ──
*.env
.env.*
!.env.example
!.env.sample
*.key
*.pem
*.p12
*.jks
*.keystore
*.crt
*.cer
*.pfx
**/secrets/
**/credentials/
**/service-account*.json
**/firebase-*.json
**/*credential*
**/*secret*
**/*token*
!**/README.md
!**/.gitkeep

# ── VAULT ──
vault/data/
vault/logs/
vault/file/
*.hcl
!deploy/vault/config/*.hcl
!deploy/vault/policies/*.hcl

# ── JAVA / SPRING BOOT ──
**/target/
*.class
*.jar
*.war
*.ear
hs_err_pid*
replay_pid*
dependency-reduced-pom.xml
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ── GRADLE ──
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# ── IDE ──
.idea/
*.iml
*.iws
*.ipr
.vscode/
*.swp
*.swo
*~
.project
.classpath
.settings/
.factorypath
*.code-workspace

# ── DOCKER ──
docker-compose.override.yml
docker-compose.local.yml

# ── KUBERNETES ──
**/charts/*.tgz

# ── TERRAFORM ──
deploy/terraform/**/*.tfstate
deploy/terraform/**/*.tfstate.*
deploy/terraform/**/.terraform/
deploy/terraform/**/*.tfvars
!deploy/terraform/**/*.tfvars.example
deploy/terraform/**/.terraform.lock.hcl
deploy/terraform/**/crash.log
deploy/terraform/**/*.tfplan
deploy/terraform/**/override.tf
deploy/terraform/**/override.tf.json
deploy/terraform/**/*_override.tf
deploy/terraform/**/*_override.tf.json
deploy/terraform/**/.terraformrc
deploy/terraform/**/terraform.rc

# ── TERRAFORM SECRETS ──
deploy/terraform/environments/dev/terraform.tfvars
deploy/terraform/environments/staging/terraform.tfvars
deploy/terraform/environments/production/terraform.tfvars

