# ── LOGS ──
*.log
logs/
logs/**/

# ── TEMP / CACHE ──
tmp/
temp/
cache/
.cache/
*.tmp
*.bak
*.orig

# ── TEST COVERAGE ──
coverage/
htmlcov/
*.cover
.coverage
.coverage.*
codecov.yml

# ── DEPENDENCY LOCK (allow pom.xml, package-lock.json) ──
# Intentionally NOT ignoring lock files

# ── PRE-COMMIT ──
.pre-commit-config.yaml

# ── SAFE GUARD: Prevent accidental secrets via naming patterns ──
