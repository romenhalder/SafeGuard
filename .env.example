# ============================================
# SAFEGUARD - Environment Variables Template
# ============================================
# HOW TO USE:
# 1. Copy this file: cp .env.example .env
# 2. Fill in your values in .env
# 3. NEVER commit .env to git
# ============================================

# ── PROJECT ──
PROJECT_NAME=safeguard
COMPOSE_PROJECT_NAME=safeguard

# ── SPRING PROFILES ──
SPRING_PROFILES_ACTIVE=local

# ── POSTGRESQL + PostGIS ──
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=safeguard_dev
POSTGRES_USER=safeguard
POSTGRES_PASSWORD=CHANGE_ME_local_dev_password

# ── REDIS ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_local_dev_password

# ── MONGODB ──
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=safeguard_incidents
MONGO_INITDB_ROOT_USERNAME=safeguard
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_local_dev_password

# ── VAULT ──
VAULT_ADDR=http://localhost:8200
VAULT_DEV_ROOT_TOKEN_ID=dev-root-token-changeme
VAULT_ENV=dev

# ── JWT SECRETS (Use Vault in staging/production) ──
JWT_SECRET=CHANGE_ME_local_jwt_secret_min_32_chars
JWT_REFRESH_SECRET=CHANGE_ME_local_refresh_secret_min_32_chars
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# ── EUREKA ──
EUREKA_CLIENT_SERVICEURL_DEFAULTZONE=http://localhost:8761/eureka/

# ── CONFIG SERVER ──
SPRING_CLOUD_CONFIG_URI=http://localhost:8888

# ── EXTERNAL SERVICES (Dev/Test keys only) ──
# Firebase Cloud Messaging
FCM_PROJECT_ID=
FCM_PRIVATE_KEY_ID=
FCM_PRIVATE_KEY=
FCM_CLIENT_EMAIL=
FCM_CLIENT_ID=

# Google Maps (use restricted key for dev)
GOOGLE_MAPS_API_KEY=CHANGE_ME

# Twilio SMS (use test credentials)
TWILIO_ACCOUNT_SID=CHANGE_ME
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_PHONE_NUMBER=+1234567890

# MSG91 (Indian SMS gateway)
MSG91_API_KEY=CHANGE_ME
MSG91_SENDER_ID=SGUARD

# ── AWS (for ECR push / staging+ prod) ──
AWS_REGION=ap-south-1
AWS_ACCOUNT_ID=CHANGE_ME
ECR_REGISTRY=CHANGE_ME.dkr.ecr.ap-south-1.amazonaws.com

# ── SERVICE PORTS ──
API_GATEWAY_PORT=8080
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082
ALERT_SERVICE_PORT=8083
LOCATION_SERVICE_PORT=8084
INCIDENT_SERVICE_PORT=8085
ADMIN_SERVICE_PORT=8086
NOTIFICATION_SERVICE_PORT=8087
ANALYTICS_SERVICE_PORT=8088
EUREKA_SERVER_PORT=8761
CONFIG_SERVER_PORT=8888

# ── LOGGING ──
LOG_LEVEL=INFO
LOG_PATTERN=%d{yyyy-MM-dd HH:mm:ss} [%thread] %-5level %logger{36} - %msg%n

# ── WEBSOCKET ──
WS_MAX_CONNECTIONS=10000
WS_IDLE_TIMEOUT=60000

# ── GPS TRACKING ──
GPS_UPDATE_INTERVAL_SECONDS=10
GPS_OFFICER_LOCATION_TTL_SECONDS=30
GPS_SEARCH_RADIUS_METERS=3000

# ── REDIS STREAMS (Message Broker) ──
REDIS_STREAM_SOS_ALERTS=safeguard:sos:alerts
REDIS_STREAM_GPS_UPDATES=safeguard:gps:updates
REDIS_STREAM_NOTIFICATIONS=safeguard:notifications
REDIS_STREAM_INCIDENTS=safeguard:incidents
